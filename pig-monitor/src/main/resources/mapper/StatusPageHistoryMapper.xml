<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pig4cloud.pig.monitor.mapper.StatusPageHistoryMapper">

	<!-- 结果映射 - 状态页历史实体 -->
	<resultMap id="BaseResultMap" type="com.pig4cloud.pig.common.core.entity.manager.StatusPageHistory">
		<id column="id" property="id"/>
		<result column="component_id" property="componentId"/>
		<result column="state" property="state"/>
		<result column="timestamp" property="timestamp"/>
		<result column="uptime" property="uptime"/>
		<result column="abnormal" property="abnormal"/>
		<result column="unknowing" property="unknowing"/>
		<result column="normal" property="normal"/>
		<result column="creator" property="creator"/>
		<result column="modifier" property="modifier"/>
		<result column="gmt_create" property="gmtCreate"/>
		<result column="gmt_update" property="gmtUpdate"/>
	</resultMap>

	<!-- 基础查询字段列表 -->
	<sql id="Base_Column_List">
		id, component_id, state, timestamp, uptime, abnormal, unknowing, normal, creator, modifier, gmt_create, gmt_update
	</sql>

	<!-- 根据时间戳范围查询状态页历史 -->
	<select id="findStatusPageHistoriesByTimestampBetween" resultMap="BaseResultMap">
		SELECT
		<include refid="Base_Column_List"/>
		FROM hzb_status_page_history
		WHERE timestamp BETWEEN #{start} AND #{end}
		ORDER BY timestamp ASC
	</select>

	<!-- 根据组件ID和时间戳范围查询状态页历史 -->
	<select id="findStatusPageHistoriesByComponentIdAndTimestampBetween" resultMap="BaseResultMap">
		SELECT
		<include refid="Base_Column_List"/>
		FROM hzb_status_page_history
		WHERE component_id = #{componentId}
		AND timestamp BETWEEN #{start} AND #{end}
		ORDER BY timestamp ASC
	</select>

</mapper>
