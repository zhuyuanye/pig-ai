<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pig4cloud.pig.monitor.mapper.ParamMapper">

	<!-- 结果映射 - 监控参数实体 -->
	<resultMap id="BaseResultMap" type="com.pig4cloud.pig.common.core.entity.manager.Param">
		<id column="id" property="id"/>
		<result column="monitor_id" property="monitorId"/>
		<result column="field" property="field"/>
		<result column="param_value" property="paramValue"/>
		<result column="type" property="type"/>
		<result column="gmt_create" property="gmtCreate"/>
		<result column="gmt_update" property="gmtUpdate"/>
	</resultMap>

	<!-- 基础查询字段列表 -->
	<sql id="Base_Column_List">
		id, monitor_id, field, param_value, type, gmt_create, gmt_update
	</sql>

	<!-- 根据监控任务ID查询参数列表 -->
	<select id="findParamsByMonitorId" resultMap="BaseResultMap">
		SELECT
		<include refid="Base_Column_List"/>
		FROM hzb_param
		WHERE monitor_id = #{monitorId}
		ORDER BY gmt_create DESC
	</select>

	<!-- 根据监控任务ID删除参数 -->
	<delete id="deleteParamsByMonitorId">
		DELETE FROM hzb_param
		WHERE monitor_id = #{monitorId}
	</delete>

	<!-- 根据监控任务ID集合批量删除参数 -->
	<delete id="deleteParamsByMonitorIdIn">
		DELETE FROM hzb_param
		WHERE monitor_id IN
		<foreach collection="monitorIds" item="monitorId" open="(" separator="," close=")">
			#{monitorId}
		</foreach>
	</delete>

</mapper>
