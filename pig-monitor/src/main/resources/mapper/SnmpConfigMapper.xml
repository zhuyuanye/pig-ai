<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pig4cloud.pig.monitor.mapper.SnmpConfigMapper">

	<!-- 结果映射 - SNMP配置信息实体 -->
	<resultMap id="BaseResultMap" type="com.pig4cloud.pig.common.core.entity.network.SnmpConfigInfo">
		<id column="id" property="id"/>
		<result column="ip" property="ip"/>
		<result column="community" property="community"/>
		<result column="version" property="version"/>
		<result column="device_type" property="deviceType"/>
		<result column="is_run_type" property="isRunType"/>
		<result column="create_time" property="createTime"/>
		<result column="update_time" property="updateTime"/>
	</resultMap>

	<!-- 基础查询字段列表 -->
	<sql id="Base_Column_List">
		id, ip, community, version, device_type, is_run_type, create_time, update_time
	</sql>

	<!-- 查询指定运行状态的SNMP配置列表 -->
	<select id="findByIsRunType" resultMap="BaseResultMap">
		SELECT
		<include refid="Base_Column_List"/>
		FROM hzb_snmp_config
		WHERE is_run_type = #{isRunType}
		ORDER BY id
	</select>

</mapper>
