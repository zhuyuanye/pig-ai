<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pig4cloud.pig.monitor.mapper.AccountUserMapper">

	<!-- 结果映射 - 账户用户实体 -->
	<resultMap id="BaseResultMap" type="com.pig4cloud.pig.common.core.entity.user.HzbUser">
		<id column="id" property="id"/>
		<result column="username" property="username"/>
		<result column="password" property="password"/>
		<result column="email" property="email"/>
		<result column="phone" property="phone"/>
		<result column="status" property="status"/>
		<result column="role" property="role"/>
		<result column="create_time" property="createTime"/>
		<result column="update_time" property="updateTime"/>
	</resultMap>

	<!-- 基础查询字段列表 -->
	<sql id="Base_Column_List">
		id, username, password, email, phone, status, role, create_time, update_time
	</sql>

	<!-- 根据用户名查询用户信息 -->
	<select id="findByUsername" resultMap="BaseResultMap">
		SELECT
		<include refid="Base_Column_List"/>
		FROM hzb_user
		WHERE username = #{username}
		LIMIT 1
	</select>

</mapper>
