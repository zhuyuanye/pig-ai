<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pig4cloud.pig.monitor.mapper.PluginItemMapper">

	<!-- 结果映射 - 插件项实体 -->
	<resultMap id="BaseResultMap" type="com.pig4cloud.pig.common.core.entity.manager.PluginItem">
		<id column="id" property="id"/>
		<result column="metadata_id" property="metadataId"/>
		<result column="class_identifier" property="classIdentifier"/>
		<result column="type" property="type"/>
	</resultMap>

	<!-- 基础查询字段列表 -->
	<sql id="Base_Column_List">
		id, metadata_id, class_identifier, type
	</sql>

	<!-- 根据类标识符列表统计插件项数量 -->
	<select id="countPluginItemByClassIdentifierIn" resultType="int">
		SELECT COUNT(*)
		FROM hzb_plugin_item
		WHERE class_identifier IN
		<foreach collection="classIdentifiers" item="identifier" open="(" separator="," close=")">
			#{identifier}
		</foreach>
	</select>

</mapper>
