<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pig4cloud.pig.monitor.mapper.CollectorMonitorBindMapper">

	<!-- 结果映射 - 采集器监控绑定实体 -->
	<resultMap id="BaseResultMap" type="com.pig4cloud.pig.common.core.entity.manager.CollectorMonitorBind">
		<id column="id" property="id"/>
		<result column="collector" property="collector"/>
		<result column="monitor_id" property="monitorId"/>
		<result column="creator" property="creator"/>
		<result column="modifier" property="modifier"/>
		<result column="gmt_create" property="gmtCreate"/>
		<result column="gmt_update" property="gmtUpdate"/>
	</resultMap>

	<!-- 基础查询字段列表 -->
	<sql id="Base_Column_List">
		id, collector, monitor_id, creator, modifier, gmt_create, gmt_update
	</sql>

	<!-- 根据采集器名称查询绑定关系 -->
	<select id="findCollectorMonitorBindsByCollector" resultMap="BaseResultMap">
		SELECT
		<include refid="Base_Column_List"/>
		FROM hzb_collector_monitor_bind
		WHERE collector = #{collector}
	</select>

</mapper>
