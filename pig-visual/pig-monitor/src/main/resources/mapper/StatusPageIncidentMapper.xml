<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pig4cloud.pig.monitor.mapper.StatusPageIncidentMapper">

	<!-- 结果映射 - 状态页事件实体 -->
	<resultMap id="BaseResultMap" type="com.pig4cloud.pig.common.core.entity.manager.StatusPageIncident">
		<id column="id" property="id"/>
		<result column="org_id" property="orgId"/>
		<result column="name" property="name"/>
		<result column="state" property="state"/>
		<result column="start_time" property="startTime"/>
		<result column="end_time" property="endTime"/>
		<result column="creator" property="creator"/>
		<result column="modifier" property="modifier"/>
		<result column="gmt_create" property="gmtCreate"/>
		<result column="gmt_update" property="gmtUpdate"/>
	</resultMap>

	<!-- 基础查询字段列表 -->
	<sql id="Base_Column_List">
		id, org_id, name, state, start_time, end_time, creator, modifier, gmt_create, gmt_update
	</sql>

</mapper>
