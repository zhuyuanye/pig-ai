<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pig4cloud.pig.monitor.mapper.MonitorMapper">

	<!-- 结果映射 - 监控任务实体 -->
	<resultMap id="BaseResultMap" type="com.pig4cloud.pig.common.core.entity.manager.Monitor">
		<id column="id" property="id"/>
		<result column="job_id" property="jobId"/>
		<result column="name" property="name"/>
		<result column="app" property="app"/>
		<result column="scrape" property="scrape"/>
		<result column="host" property="host"/>
		<result column="intervals" property="intervals"/>
		<result column="status" property="status"/>
		<result column="type" property="type"/>
		<result column="labels" property="labels" typeHandler="com.pig4cloud.pig.common.mybatis.handler.JsonMapTypeHandler"/>
		<result column="annotations" property="annotations" typeHandler="com.pig4cloud.pig.common.mybatis.handler.JsonMapTypeHandler"/>
		<result column="description" property="description"/>
		<result column="creator" property="creator"/>
		<result column="modifier" property="modifier"/>
		<result column="gmt_create" property="gmtCreate"/>
		<result column="gmt_update" property="gmtUpdate"/>
	</resultMap>

	<!-- 基础查询字段列表 -->
	<sql id="Base_Column_List">
		id, job_id, name, app, scrape, host, intervals, status, type,
		labels, annotations, description, creator, modifier, gmt_create, gmt_update
	</sql>

	<!-- 根据ID集合批量删除监控任务 -->
	<delete id="deleteAllByIdIn">
		DELETE FROM hzb_monitor
		WHERE id IN
		<foreach collection="monitorIds" item="id" open="(" separator="," close=")">
			#{id}
		</foreach>
	</delete>

	<!-- 根据ID集合查询监控任务列表 -->
	<select id="findMonitorsByIdIn" resultMap="BaseResultMap">
		SELECT
		<include refid="Base_Column_List"/>
		FROM hzb_monitor
		WHERE id IN
		<foreach collection="monitorIds" item="id" open="(" separator="," close=")">
			#{id}
		</foreach>
		ORDER BY gmt_create DESC
	</select>

	<!-- 根据监控类型查询监控任务列表 -->
	<select id="findMonitorsByAppEquals" resultMap="BaseResultMap">
		SELECT
		<include refid="Base_Column_List"/>
		FROM hzb_monitor
		WHERE app = #{app}
		ORDER BY gmt_create DESC
	</select>

	<!-- 查询已下发采集任务的监控任务（排除指定状态） -->
	<select id="findMonitorsByStatusNotInAndJobIdNotNull" resultMap="BaseResultMap">
		SELECT
		<include refid="Base_Column_List"/>
		FROM hzb_monitor
		WHERE job_id IS NOT NULL
		<if test="statusList != null and statusList.size() > 0">
			AND status NOT IN
			<foreach collection="statusList" item="status" open="(" separator="," close=")">
				#{status}
			</foreach>
		</if>
		ORDER BY gmt_create DESC
	</select>

	<!-- 根据监控名称查询监控任务 -->
	<select id="findMonitorByNameEquals" resultMap="BaseResultMap">
		SELECT
		<include refid="Base_Column_List"/>
		FROM hzb_monitor
		WHERE name = #{name}
		LIMIT 1
	</select>

	<!-- 统计各监控类型和状态的数量 -->
	<select id="findAppsStatusCount" resultType="com.pig4cloud.pig.monitor.pojo.dto.AppCount">
		SELECT
		app as app,
		status as status,
		COUNT(id) as count
		FROM hzb_monitor
		GROUP BY app, status
	</select>

	<!-- 更新监控任务状态 -->
	<update id="updateMonitorStatus">
		UPDATE hzb_monitor
		SET status = #{status},
		gmt_update = NOW()
		WHERE id = #{id}
	</update>

</mapper>
