<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pig4cloud.pig.monitor.mapper.StatusPageIncidentContentMapper">

	<!-- 结果映射 - 事件内容实体 -->
	<resultMap id="BaseResultMap" type="com.pig4cloud.pig.common.core.entity.manager.StatusPageIncidentContent">
		<id column="id" property="id"/>
		<result column="incident_id" property="incidentId"/>
		<result column="message" property="message"/>
		<result column="state" property="state"/>
		<result column="timestamp" property="timestamp"/>
		<result column="creator" property="creator"/>
		<result column="modifier" property="modifier"/>
		<result column="gmt_create" property="gmtCreate"/>
		<result column="gmt_update" property="gmtUpdate"/>
	</resultMap>

	<!-- 基础查询字段列表 -->
	<sql id="Base_Column_List">
		id, incident_id, message, state, timestamp, creator, modifier, gmt_create, gmt_update
	</sql>

</mapper>
