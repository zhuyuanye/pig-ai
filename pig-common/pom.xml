	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>commons-net</groupId>
				<artifactId>commons-net</artifactId>
				<version>${commons-net}</version>
			</dependency>
			<dependency>
				<groupId>com.pig4cloud</groupId>
				<artifactId>pig-common-plugin</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>com.pig4cloud</groupId>
				<artifactId>pig-common-base</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>com.pig4cloud</groupId>
				<artifactId>pig-common-core</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>com.pig4cloud</groupId>
				<artifactId>pig-common-warehouse</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>com.pig4cloud</groupId>
				<artifactId>pig-common-remoting</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>com.pig4cloud</groupId>
