<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pig4cloud.pig.common.warehouse.mapper.HistoryMapper">
    <delete id="deleteOlderHistoriesRecord">
        DELETE FROM hzb_history WHERE id IN (SELECT t2.id FROM (SELECT t1.id FROM hzb_history t1 LIMIT #{delNum}) AS t2)
    </delete>
    <update id="truncateTable">
        TRUNCATE TABLE hzb_history
    </update>
</mapper>
