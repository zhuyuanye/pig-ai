<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pig4cloud.pig.common.alert.mapper.AlertHistoryMapper">

    <!-- 根据时间范围删除告警历史记录 -->
    <delete id="deleteByCreateAlertTimeBetween">
        DELETE FROM hzb_alert_history
        WHERE create_alert_time &gt;= #{start} AND create_alert_time &lt;= #{end}
    </delete>

</mapper>
